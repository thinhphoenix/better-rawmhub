{
  "name": "better-rawmhub",
  "version": "2.0.26",
  "private": true,
  "description": "Browser-native RAWM HUB rebuild with WebHID transport",
  "scripts": {
    "build:ant": "esbuild tools/ant-entry.js --bundle --minify --format=iife --outfile=assets/ant.js --loader:.js=jsx",
    "build": "npm run build:ant && node tools/build.mjs",
    "test": "node tools/test-transport.mjs",
    "start": "node tools/start.mjs",
    "serve": "python -m http.server 8080",
    "cf:login": "wrangler login",
    "bump": "node tools/release.mjs --bump-only",
    "release": "node tools/release.mjs",
    "preview": "npm run build && wrangler pages dev public",
    "deploy": "npm run build && wrangler pages deploy public --project-name better-rawmhub --branch main"
  },
  "dependencies": {
    "antd": "^5.29.3",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "pngjs": "^7.0.0",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=20"
  }
}
